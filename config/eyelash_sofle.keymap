#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/backlight.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };
&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <100>;
    };

    // CONDITIONAL LAYERS - Makes LOWER + RAISE = ADJUST
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    combos {
        compatible = "zmk,combos";
        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // LAYER 0: QWERTY (Base)
        QWERTY {
            bindings = <
&kp GRAVE  &kp N1    &kp N2    &kp N3     &kp N4    &kp N5       &kp UP        &kp N6     &kp N7     &kp N8     &kp N9     &kp N0    &kp GRAVE
&kp ESC    &kp Q     &kp W     &kp E      &kp R     &kp T        &kp DOWN      &kp Y      &kp U      &kp I      &kp O      &kp P     &kp BSPC
&kp TAB    &kp A     &kp S     &kp D      &kp F     &kp G        &kp LEFT      &kp H      &kp J      &kp K      &kp L      &kp SEMI  &kp SQT
&kp LSHFT  &kp Z     &kp X     &kp C      &kp V     &kp B        &kp RIGHT     &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH  &kp RSHFT
&kp C_MUTE &kp LGUI  &kp LALT  &kp LCTRL  &mo 1     &kp SPACE    &kp ENTER     &kp ENTER  &mo 2      &kp RCTRL  &kp RALT   &kp RGUI
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            display-name = "QWERTY";
        };

        // LAYER 1: LOWER (Symbols & F-keys)
        LOWER {
            bindings = <
&trans     &kp F1     &kp F2     &kp F3     &kp F4     &kp F5       &mmv MOVE_UP    &kp F6     &kp F7     &kp F8     &kp F9     &kp F10    &kp F11
&kp GRAVE  &kp N1     &kp N2     &kp N3     &kp N4     &kp N5       &mmv MOVE_DOWN  &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &kp F12
&trans     &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT    &mmv MOVE_LEFT  &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR   &kp RPAR   &kp PIPE
&trans     &kp MINUS  &kp EQUAL  &kp PLUS   &kp LBRC   &kp RBRC     &mmv MOVE_RIGHT &kp LBKT   &kp RBKT   &kp SEMI   &kp COLON  &kp BSLH   &trans
&trans     &trans     &trans     &trans     &trans     &trans       &mkp LCLK       &trans     &trans     &trans     &trans     &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            display-name = "LOWER";
        };

        // LAYER 2: RAISE (Navigation)
        RAISE {
            bindings = <
&trans  &trans    &trans    &trans         &trans     &trans       &mmv MOVE_UP    &trans     &trans     &trans            &trans            &trans           &trans
&trans  &kp INS   &kp PSCRN &kp K_CMENU    &trans     &trans       &mmv MOVE_DOWN  &kp PG_DN  &kp PG_UP  &kp LC(LEFT)      &kp LC(RIGHT)     &kp LC(BSPC)     &kp BSPC
&trans  &kp LALT  &kp LCTRL &kp LSHFT      &trans     &kp CAPS     &mmv MOVE_LEFT  &kp LEFT   &kp DOWN   &kp UP            &kp RIGHT         &kp DEL          &kp BSPC
&trans  &kp LC(Z) &kp LC(X) &kp LC(C)      &kp LC(V)  &trans       &mmv MOVE_RIGHT &trans     &kp HOME   &trans            &kp END           &trans           &trans
&trans  &trans    &trans    &trans         &trans     &trans       &mkp LCLK       &trans     &trans     &trans            &trans            &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            display-name = "RAISE";
        };

        // LAYER 3: ADJUST (Settings - RGB + Media Keys)
        ADJUST {
            bindings = <
&sys_reset     &bt BT_SEL 0       &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_CLR        &mmv MOVE_UP    &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &rgb_ug RGB_SPI  &rgb_ug RGB_EFF  &bootloader
&out OUT_TOG   &rgb_ug RGB_TOG    &bl BL_TOG       &bl BL_INC       &bl BL_DEC       &bt BT_CLR_ALL    &mmv MOVE_DOWN  &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_BRD  &rgb_ug RGB_SPD  &rgb_ug RGB_EFR  &trans
&trans         &rgb_ug RGB_COLOR_HSB(0,100,50)    &rgb_ug RGB_COLOR_HSB(120,100,50)  &rgb_ug RGB_COLOR_HSB(240,100,50)  &trans  &trans   &mmv MOVE_LEFT  &trans  &kp C_VOL_DN  &kp C_MUTE  &kp C_VOL_UP  &trans  &trans
&trans         &trans             &trans           &trans           &trans           &trans            &mmv MOVE_RIGHT &trans  &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT  &soft_off  &trans
&trans         &trans             &trans           &trans           &trans           &trans            &mkp LCLK       &trans  &trans      &trans            &trans      &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            display-name = "ADJUST";
        };
    };
};
